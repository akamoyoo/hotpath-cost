    import tempfile
    work = os.path.abspath(args.work) if args.work else tempfile.mkdtemp(prefix='fn-effects-')  # compiles run in other directories
    args._work = work
    os.makedirs(os.path.join(work, 'bc'), exist_ok=True)
    times = {}
    t0 = time.time()

    bcs, build_info = [], []
    jobs = []
    for i in args.inputs:
        if i.endswith(BC_EXT):
            bcs.append(os.path.abspath(i))
        elif i.endswith(SRC_EXT + C_EXT):
            std = [] if i.endswith(C_EXT) else [f'-std={args.std}']
