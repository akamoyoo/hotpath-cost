    ap.add_argument('--precision', choices=['type', 'rta', 'pta'], help='indirect-call resolution (default: the policy, pta)')
    ap.add_argument('--pta-scope', choices=['module', 'component', 'auto'],
                    help='points-to: one solve over the module (default), per strongly connected component of the direct-call '
                         'graph with calls between components cut, or auto (component if the module solve is over its budget)')
