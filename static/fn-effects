    ap.add_argument('--why', action='append', default=[], metavar='FUNCTION',
                    help="a function's own sites and the callees that bring each class (substring of the demangled name)")
    ap.add_argument('--class', dest='sig_classes', action='append', help='classes for --functions/--why (default: alloc free lock syscall throw abort)')
