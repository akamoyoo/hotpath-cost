#!/usr/bin/env python3
"""fn-effects: whole-program effect analysis of C++ on LLVM IR.

Builds whole-program bitcode (from sources, from bitcode files, or by re-running an existing
compile_commands.json with Clang), runs the FnEffects pass plugin under a policy, and writes the JSON
report, a text report, and optionally the effect table of every function.

  fn-effects [options] SOURCES/BITCODE...          analyse
  fn-effects -p build/compile_commands.json ...    analyse a project without changing its build
  fn-effects --diff OLD.json NEW.json              what is new; exit 1 if a hazard appeared
"""
import argparse, collections, concurrent.futures, fnmatch, hashlib, json, os, re, shlex, shutil, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
SRC_EXT = ('.cpp', '.cc', '.cxx', '.c++', '.C', '.cp')
C_EXT = ('.c',)
BC_EXT = ('.bc', '.ll')

# ------------------------------------------------------------------------------------------- toolchain

def find_tool(name, args):
    cands = []
    if args.llvm_bin:
        cands.append(os.path.join(args.llvm_bin, name))
    if os.environ.get('FX_LLVM_BIN'):
        cands.append(os.path.join(os.environ['FX_LLVM_BIN'], name))
    cache = os.path.join(HERE, 'build', 'CMakeCache.txt')
    if os.path.exists(cache):  # the LLVM the plugin was built against
        for line in open(cache):
            if line.startswith('LLVM_DIR:'):
                cands.append(os.path.normpath(os.path.join(line.split('=', 1)[1].strip(), '..', '..', '..', 'bin', name)))
    w = shutil.which('llvm-config')
    if w:
        try:
            b = subprocess.run([w, '--bindir'], capture_output=True, text=True).stdout.strip()
            cands.append(os.path.join(b, name))
        except OSError:
            pass
    w = shutil.which(name)
    if w:
        cands.append(w)
    for c in cands:
        if os.path.exists(c):
            return c
    sys.exit(f'fn-effects: cannot find {name}; set --llvm-bin or FX_LLVM_BIN')


def plugin_path(args):
    p = args.plugin or os.path.join(HERE, 'build', 'FnEffects.so')
    if not os.path.exists(p):
        sys.exit(f'fn-effects: plugin not found at {p}; build it with cmake (see README)')
    return p

