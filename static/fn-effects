            sys.exit(f'fn-effects: do not know what to do with {i}')
    if args.compile_commands:
        jobs += load_compile_commands(args.compile_commands, args.cc_filter, args.cc_exclude)
    if jobs:
        with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as ex:
            res = list(ex.map(lambda j: compile_one(j, clangxx, clang, work, args), jobs))
        for r in res:
            build_info.append(r)
            if r['ok']:
                bcs.append(r['bc'])
            else:
                print(f"fn-effects: warning: {r['file']} does not compile with Clang; continuing without it", file=sys.stderr)
    times['compile_s'] = round(time.time() - t0, 2)
    if not bcs:
        sys.exit('fn-effects: nothing to analyse')

    missing = {}
    for r in build_info:
        if not r['ok']:
            for s in defined_symbols_of_object(r.get('output'), nm):
                missing.setdefault(s, os.path.relpath(r['file'], args.path_base))
    missing_file = os.path.join(work, 'missing.json')
    with open(missing_file, 'w') as f:
        json.dump(missing, f)

    t1 = time.time()
    whole = os.path.join(work, 'whole.bc')
    lst = os.path.join(work, 'inputs.txt')
    p = subprocess.run([link, '-o', whole] + bcs, capture_output=True, text=True)
    if p.returncode != 0:
        msg = p.stderr.strip()
        if 'multiply defined' in msg or 'symbol multiply' in msg:
            msg += '\n(fn-effects: two translation units define the same symbol; the compile database probably holds ' \
                   'several programs. Select one with --cc-filter / --cc-exclude.)'
        sys.exit(f'fn-effects: llvm-link failed:\n{msg}')
    times['link_s'] = round(time.time() - t1, 2)

    entries = list(args.entry)
    if args.entries_file:
        with open(args.entries_file) as f:
            for l in f:
                l = l.split('#', 1)[0].strip()
                if l:
                    entries.append(l)
    toolroot = os.path.dirname(os.path.dirname(os.path.realpath(clangxx)))
    cmd = [opt, f'-load-pass-plugin={plugin_path(args)}', '-passes=fn-effects', '-disable-output', whole,
           f'-fx-policy={args.policy}', f'-fx-out={args.out}', f'-fx-missing={missing_file}',
           f'-fx-incomplete={sum(1 for b in build_info if not b["ok"])}',
           f'-fx-path-map={os.path.realpath(toolroot)}=<toolchain>/', f'-fx-path-map={toolroot}=<toolchain>/',
           f'-fx-path-map={os.path.realpath(args.path_base)}=']
    target = args.compile_commands or (' '.join(os.path.relpath(i, args.path_base) for i in args.inputs))
    cmd.append(f'-fx-target={target}')
    for e in entries:
        cmd.append(f'-fx-entry={e}')
    if args.entry_kind:
        cmd.append(f'-fx-entry-kind={args.entry_kind}')
    auto_summ, summ_notes = default_summaries(args, clangxx, jobs)
    for s in args.summary + auto_summ:
        cmd.append(f'-fx-summary={s}')
    if (args.functions or args.why) and not args.effects:
        args.effects = os.path.join(work, 'effects.json')
    if args.effects:
        cmd.append(f'-fx-effects={args.effects}')
    if args.all:
        cmd.append('-fx-all-findings')
    if args.full:
        cmd.append('-fx-full')
    if args.strict:
        cmd.append('-fx-strict')
    if args.precision:
        cmd.append(f'-fx-precision={args.precision}')
    if args.pta_budget:
        cmd.append(f'-fx-pta-budget={args.pta_budget}')
    if args.pta_scope:
        cmd.append(f'-fx-pta-scope={args.pta_scope}')
    # -femulated-tls is a code-generation option that the IR does not record (README, rule (d))
    seen_flags = shlex.split(args.cflags or '') + [a for j in jobs for a in (j.get('args') or [])]
    if args.emulated_tls or ('-femulated-tls' in seen_flags and '-fno-emulated-tls' not in seen_flags):
        cmd.append('-fx-emulated-tls')
    t2 = time.time()
    tcmd = ['/usr/bin/time', '-f', '%M'] if os.path.exists('/usr/bin/time') else []
    p = subprocess.run(tcmd + cmd, capture_output=True, text=True)
    times['analyse_s'] = round(time.time() - t2, 2)
    err = p.stderr
    peak = None
    if tcmd:
        lines = err.strip().splitlines()
        if lines and lines[-1].strip().isdigit():
            peak = int(lines[-1].strip())
            err = '\n'.join(lines[:-1])
    if p.returncode != 0:
        sys.exit(f'fn-effects: analysis failed:\n{err}')
    if err.strip():
        print(err.strip(), file=sys.stderr)
    rep = json.load(open(args.out))
    CUR_FUNCS[:] = rep.get('functions', [])
    rep['build'] = {'summaries_skipped': summ_notes, 'duplicates_skipped': [os.path.relpath(x, args.path_base) for x in DUPLICATES],
                    'toolchain': sorted({' '.join(gcc_toolchain_flags(j.get('compiler'), args.gcc_toolchain)) for j in jobs}),
                    'translation_units': len(build_info), 'failed': [os.path.relpath(b['file'], args.path_base) for b in build_info if not b['ok']],
                    'dropped_flags': sorted({d for b in build_info for d in b['dropped']}),
                    'functions_not_seen': len(missing), 'times': times, 'opt_peak_rss_kb': peak}
    with open(args.out, 'w') as f:
        json.dump(rep, f, indent=1)

    baseline = load_baseline(args.baseline)
    out = sys.stdout if args.text == '-' else open(args.text, 'w')
    if args.text_full:
        text_report(rep, args, build_info, baseline, out)
    else:
        text_summary(rep, args, build_info, baseline, out)
    if args.time:
        out.write(f"\ntimes: {times}  opt peak RSS: {peak} kB\n")
    if out is not sys.stdout:
        out.close()
    if args.write_baseline:
        write_baseline(args.write_baseline, rep)
    if args.functions or args.why:
        print_signatures(json.load(open(args.effects)), args, sys.stdout if args.text != '-' else sys.stdout)
    if args.check:
        bad = False
        for e in rep['entries']:
            forb = {v['class'] for v in e.get('violations', [])}
            for f in e['findings']:
                if f['class'] in forb and finding_key(e['entry'], f) not in baseline:
                    bad = True
            for c in forb:
                # unknown and none* are not guarantees: a violation unless the baseline accepts them
                v = e['verdict'][c]
                if v in ('unknown', 'none*') and f"{e['entry']}|{c}|verdict:{v}" not in baseline:
                    bad = True
        sys.exit(1 if bad else 0)


if __name__ == '__main__':
    main()
